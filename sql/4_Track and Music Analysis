--Query 23 — Most expensive tracks
SELECT
    name,
    unit_price
FROM track
ORDER BY unit_price DESC
LIMIT 10;
--Query 24 — Tracks by genre
SELECT
    g.name AS genre,
    COUNT(t.track_id) AS track_count
FROM genre g
JOIN track t
    ON g.genre_id = t.genre_id
GROUP BY g.name
ORDER BY track_count DESC;
--Query 25 — Top 10 longest tracks
SELECT
    name,
    milliseconds
FROM track
ORDER BY milliseconds DESC
LIMIT 10;
--Query 26 — Average track length by genre
SELECT
    g.name AS genre,
    ROUND(AVG(t.milliseconds) / 60000.0, 2) AS average_length_minutes
FROM genre g
JOIN track t
    ON g.genre_id = t.genre_id
GROUP BY g.name
ORDER BY average_length_minutes DESC;
--Query 27 — Number of tracks in each album
SELECT
    a.title AS album,
    ar.name AS artist,
    COUNT(t.track_id) AS track_count
FROM album a
JOIN artist ar
    ON a.artist_id = ar.artist_id
JOIN track t
    ON a.album_id = t.album_id
GROUP BY a.title, ar.name
ORDER BY track_count DESC;
--Query 28 — Artists with the most albums
SELECT
    ar.name AS artist,
    COUNT(a.album_id) AS album_count
FROM artist ar
JOIN album a
    ON ar.artist_id = a.artist_id
GROUP BY ar.name
ORDER BY album_count DESC
LIMIT 10;
